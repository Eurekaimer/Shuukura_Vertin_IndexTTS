#!/bin/sh
# 渲染有声书；进程因信号崩溃（SIGSEGV/SIGABRT 等）时自动从检查点续跑。
set -u

ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
cd "$ROOT"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

attempt=0
while :; do
  attempt=$((attempt + 1))
  "$ROOT/index-tts/.venv/bin/python" -u "$ROOT/tools/tts_book.py" \
    --book "$ROOT/books/shuukura-zh" --out-dir "$ROOT/audiobook/shuukura-zh" \
    --per-file 20 --format flac --duration-factor 1.0 --device cuda:0 --smooth "$@"
  status=$?
  [ "$status" -eq 0 ] && exit 0
  # 只重试崩溃（>=128 表示被信号终止）；配置/参数错误直接退出，避免死循环。
  if [ "$status" -lt 128 ] || [ "$attempt" -ge 100 ]; then
    echo "vertin-read: exited with status $status" >&2
    exit "$status"
  fi
  echo "vertin-read: crashed with status $status (attempt $attempt);" \
       "resuming from checkpoints in 15s" >&2
  sleep 15
done
